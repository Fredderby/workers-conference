# =============================================================================
# Workers Conference — Environment Variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# DATABASE_URL is the SINGLE source of truth for the database connection.
# Set it in Dokploy → Project → Environment for production.
# =============================================================================

# Database — Dokploy managed PostgreSQL (internal hostname)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://app_user:your_password@workers-data-jdojwz:5432/app_data

# JWT — change in production, keep the same values across deploys
JWT_SECRET=workers-conf-2026-super-secret-key-change-in-prod
JWT_REFRESH_SECRET=workers-conf-2026-refresh-secret-change-in-prod

# App
NEXT_PUBLIC_APP_URL=http://localhost:3056
NODE_ENV=production
